// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model EmailScan {
  id            String   @id @default(cuid())
  source        String   // "paste", "upload", "gmail", "outlook"
  fileName      String?
  senderEmail   String?
  senderName    String?
  subject       String?
  emailBody     String
  isSpam        Boolean?
  spamScore     Float?
  isAiGenerated Boolean?
  aiConfidence  Float?
  threatType    String?  // "phishing", "voiceship", "spoofing", "malware", "social_engineering", "none"
  analysisJson  String?  // Full LLM analysis as JSON
  reportPath    String?  // Path to generated PDF
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
